rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if true;
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if true;

      match /questions/{questionId} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /attempts/{attemptId} {
      allow create: if true;
      allow read: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}
