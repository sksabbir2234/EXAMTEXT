<!DOCTYPE html>
<html lang="bn">
<head>
  <%- include('partials/head', { title: 'Exam Portal - Home', ogTitle: 'Exam Portal', ogDescription: 'Take exams online - CSE College Teacher' }) %>
</head>
<body>
  <div class="header">
    <h1>📝 Exam Portal</h1>
    <p>Select a subject to begin</p>
  </div>
  <div class="container">
    <div id="subjects" class="subject-grid">
      <div class="loading"><div class="spinner"></div></div>
    </div>
  </div>
  <div class="toast" id="toast"></div>
  <script src="/js/app.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const container = document.getElementById('subjects');
      try {
        const res = await fetch('/api/subjects');
        const subjects = await res.json();
        if (subjects.length === 0) {
          container.innerHTML = '<div class="empty-state"><div class="icon">📚</div><p>No subjects available yet.</p></div>';
          return;
        }
        container.innerHTML = subjects.map((s, i) => `
          <a href="/subject?id=${s.id}" class="subject-card animate-fadeInUp stagger-${i % 4 + 1}">
            <h3>${s.name}</h3>
            <p>${s.description || 'Click to view exams'}</p>
          </a>
        `).join('');
      } catch (err) {
        container.innerHTML = '<div class="empty-state"><p>Error loading subjects.</p></div>';
      }
    });
  </script>
</body>
</html>
