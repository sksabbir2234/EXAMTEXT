<!DOCTYPE html>
<html lang="bn">
<head>
  <%- include('partials/head', { title: 'Exam - Exam Portal' }) %>
</head>
<body>
  <div class="timer" id="timer" style="display:none;">00:00</div>
  <div class="header">
    <h1 id="exam-title">Loading...</h1>
  </div>
  <div class="container">
    <div class="progress-bar"><div class="progress-fill" id="progress" style="width:0%"></div></div>
    <div id="questions">
      <div class="loading"><div class="spinner"></div></div>
    </div>
    <button class="btn btn-success btn-block" id="submit-btn" style="margin-top:20px;display:none;">Submit Exam</button>
  </div>
  <div class="toast" id="toast"></div>
  <script src="/js/app.js"></script>
  <script>
    const examId = new URLSearchParams(window.location.search).get('id');
    let questions = [];
    let answers = {};
    let timerInterval;
    let secondsElapsed = 0;

    document.addEventListener('DOMContentLoaded', loadExam);

    async function loadExam() {
      try {
        const res = await fetch(`/api/exam/${examId}`);
        const exam = await res.json();
        document.getElementById('exam-title').textContent = exam.title;

        const qRes = await fetch(`/api/exam/${examId}/questions`);
        questions = await qRes.json();

        renderQuestions();
        document.getElementById('submit-btn').style.display = 'block';

        if (exam.durationMinutes > 0) {
          startTimer(exam.durationMinutes * 60);
        }
      } catch (err) {
        document.getElementById('questions').innerHTML = '<div class="empty-state"><p>Error loading exam.</p></div>';
      }
    }

    function renderQuestions() {
      const container = document.getElementById('questions');
      const labels = ['A', 'B', 'C', 'D'];
      container.innerHTML = questions.map((q, i) => `
        <div class="question-card animate-fadeInUp" style="animation-delay:${i * 0.05}s;opacity:0;">
          <div class="question-number">${i + 1}</div>
          <div class="question-text">${q.questionText}</div>
          <div class="options">
            ${q.options.map((opt, oi) => `
              <div class="option" onclick="selectOption(${i}, ${oi})" id="opt-${i}-${oi}">
                <span class="option-label">${labels[oi]}</span>
                <span>${opt}</span>
              </div>
            `).join('')}
          </div>
        </div>
      `).join('');
    }

    function selectOption(qi, oi) {
      questions[qi].options.forEach((_, j) => {
        document.getElementById(`opt-${qi}-${j}`).classList.remove('selected');
      });
      document.getElementById(`opt-${qi}-${oi}`).classList.add('selected');
      answers[qi] = oi;
      document.getElementById('progress').style.width = (Object.keys(answers).length / questions.length * 100) + '%';
    }

    function startTimer(totalSeconds) {
      const timerEl = document.getElementById('timer');
      timerEl.style.display = 'block';
      timerInterval = setInterval(() => {
        secondsElapsed++;
        const remaining = totalSeconds - secondsElapsed;
        if (remaining <= 0) { clearInterval(timerInterval); submitExam(); return; }
        const m = Math.floor(remaining / 60);
        const s = remaining % 60;
        timerEl.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
        if (remaining <= 60) timerEl.className = 'timer danger';
        else if (remaining <= 300) timerEl.className = 'timer warning';
      }, 1000);
    }

    document.getElementById('submit-btn').addEventListener('click', () => {
      if (!confirm('Submit exam?')) return;
      submitExam();
    });

    async function submitExam() {
      clearInterval(timerInterval);
      let score = 0;
      questions.forEach((q, i) => {
        if (answers[i] === q.correctOptionIndex) score++;
      });

      const studentName = sessionStorage.getItem('studentName') || 'Anonymous';
      try {
        const res = await fetch('/api/attempt', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ examId, studentName, score, total: questions.length, answers, timeTaken: secondsElapsed })
        });
        const data = await res.json();
        window.location.href = `/result?id=${data.id}&examId=${examId}`;
      } catch (err) {
        showToast('Error submitting. Try again.');
      }
    }
  </script>
</body>
</html>
