<!DOCTYPE html>
<html lang="bn">
<head>
  <%- include('partials/head', { title: (typeof exam !== 'undefined' ? exam.title : 'Exam') + ' - Exam Portal', ogTitle: (typeof exam !== 'undefined' ? exam.title : 'Exam') + ' - Exam Portal', ogDescription: (typeof exam !== 'undefined' ? exam.totalQuestions + ' questions | Take this exam now!' : 'Take this exam now!') }) %>
</head>
<body>
  <div class="header">
    <a href="/" class="back-link">← Back</a>
    <h1 id="exam-title"><%= typeof exam !== 'undefined' ? exam.title : 'Loading...' %></h1>
    <p id="exam-subject"><%= typeof exam !== 'undefined' ? exam.subjectName : '' %></p>
  </div>
  <div class="container">
    <div class="card animate-fadeInUp" id="exam-info">
      <div class="stats-row">
        <div class="stat-item stagger-1">
          <div class="stat-value blue"><%= typeof exam !== 'undefined' ? exam.totalQuestions : 0 %></div>
          <div class="stat-label">Questions</div>
        </div>
        <div class="stat-item stagger-2">
          <div class="stat-value blue"><%= typeof exam !== 'undefined' ? (exam.durationMinutes > 0 ? exam.durationMinutes + ' min' : 'No limit') : '0' %></div>
          <div class="stat-label">Duration</div>
        </div>
      </div>
    </div>
    <div class="card animate-fadeInUp stagger-2">
      <h2 style="margin-bottom:16px;">Enter Your Name</h2>
      <form id="name-form">
        <div class="form-group">
          <input type="text" id="student-name" placeholder="Your name" required autocomplete="name">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Start Exam</button>
      </form>
    </div>
  </div>
  <div class="toast" id="toast"></div>
  <script src="/js/app.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('name-form');
      const nameInput = document.getElementById('student-name');
      const saved = sessionStorage.getItem('studentName');
      if (saved) nameInput.value = saved;

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = nameInput.value.trim();
        if (!name) return;
        sessionStorage.setItem('studentName', name);
        window.location.href = '/exam?id=<%= typeof examId !== "undefined" ? examId : "" %>';
      });
    });
  </script>
</body>
</html>
