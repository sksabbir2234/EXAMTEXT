<!DOCTYPE html>
<html lang="bn">
<head>
  <%- include('partials/head', { title: 'CSE College Teacher - Exam Portal', ogTitle: 'CSE College Teacher Exams', ogDescription: '10 chapters × 30 MCQs each' }) %>
</head>
<body>
  <div class="header">
    <a href="/" class="back-link">← Back</a>
    <h1>📚 CSE College Teacher</h1>
    <p>10 chapters × 30 MCQs each</p>
  </div>
  <div class="container">
    <div id="chapters" class="exam-list">
      <div class="loading"><div class="spinner"></div></div>
    </div>
  </div>
  <div class="toast" id="toast"></div>
  <script src="/js/app.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const container = document.getElementById('chapters');
      try {
        const res = await fetch('/api/exams/cse-college-teacher');
        const exams = await res.json();
        if (exams.length === 0) {
          container.innerHTML = '<div class="empty-state"><div class="icon">📭</div><p>No CSE exams uploaded yet.</p><p style="margin-top:8px;font-size:0.85rem;">Upload via <a href="/admin">Admin Panel</a></p></div>';
          return;
        }
        container.innerHTML = exams.map((e, i) => `
          <div class="exam-item animate-fadeInUp stagger-${i % 4 + 1}">
            <div class="exam-item-info">
              <h4>${e.title}</h4>
              <small>${e.totalQuestions} questions | ${e.durationMinutes || 0} min</small>
            </div>
            <div class="exam-item-actions">
              <a href="/exam-intro?id=${e.id}" class="btn btn-primary btn-sm">Start</a>
              <button class="btn btn-outline btn-sm" onclick="shareExam('${e.id}', '${e.title}')">Share</button>
            </div>
          </div>
        `).join('');
      } catch (err) {
        container.innerHTML = '<div class="empty-state"><p>Error loading chapters.</p></div>';
      }

      window.shareExam = (id, title) => {
        const url = window.location.origin + '/exam-intro?id=' + id;
        if (navigator.share) {
          navigator.share({ title: title, url: url });
        } else {
          navigator.clipboard.writeText(url);
          showToast('Link copied!');
        }
      };
    });
  </script>
</body>
</html>
