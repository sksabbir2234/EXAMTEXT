<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title><%= typeof title !== 'undefined' ? title : 'Exam Portal' %></title>
<meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : 'Exam Portal' %>">
<meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : 'Take exams online' %>">
<meta property="og:type" content="website">
<meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/images/exam-preview.png' %>">
<meta property="og:url" content="<%= typeof ogUrl !== 'undefined' ? ogUrl : '' %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : 'Exam Portal' %>">
<meta name="twitter:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : 'Take exams online' %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
