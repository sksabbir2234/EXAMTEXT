---
import Layout from '../layouts/Layout.astro';

const examId = Astro.url.searchParams.get('examId') || '';
const rawScore = Astro.url.searchParams.get('score') || '0';
const rawTotal = Astro.url.searchParams.get('total') || '0';
const rawCorrect = Astro.url.searchParams.get('correct');
const rawWrong = Astro.url.searchParams.get('wrong');
const rawSkipped = Astro.url.searchParams.get('skipped');
const rawPenalty = Astro.url.searchParams.get('penalty');

function safeInt(v: string): number {
  const m = v.match(/\d+/);
  return m ? parseInt(m[0], 10) : 0;
}

function safeFloat(v: string): number {
  const m = v.match(/[\d.]+/);
  return m ? parseFloat(m[0]) : 0;
}

const score = safeInt(rawScore);
const total = safeInt(rawTotal);
const correctParam = rawCorrect !== null ? safeInt(rawCorrect) : null;
const wrongParam = rawWrong !== null ? safeInt(rawWrong) : null;
const skippedParam = rawSkipped !== null ? safeInt(rawSkipped) : null;
const penaltyParam = rawPenalty !== null ? safeFloat(rawPenalty) : null;
---
<Layout title="Result - ExamText" navBack={true} navTitle="Exam Result">
  <!-- Print-only header -->
  <div class="print-header max-w-3xl mx-auto px-4 py-4 border-b border-surface-200 mb-4">
    <h1 class="text-2xl font-bold text-surface-900">ExamText — পরীক্ষার ফলাফল</h1>
    <p class="text-sm text-surface-400">Printed: <span id="print-date"></span></p>
  </div>
  <script is:inline>
    var pd = document.getElementById('print-date');
    if (pd) pd.textContent = new Date().toLocaleString('bn-BD');
  </script>

  <div class="max-w-3xl mx-auto px-4 py-10 space-y-6">

    {(!examId) ? (
      <div class="card p-8 text-center animate-scale-in">
        <div class="w-16 h-16 rounded-3xl bg-red-50 flex items-center justify-center text-3xl mx-auto mb-6">⚠️</div>
        <h1 class="text-xl font-bold text-surface-900 mb-2">Invalid result link</h1>
        <p class="text-surface-400 text-sm mb-6">Missing exam information.</p>
        <a href="/" class="btn-primary text-sm px-6 py-3 inline-block">Go Home</a>
      </div>
    ) : (
    <!-- Result Card -->
    <div id="result-card" class="card p-8 text-center animate-scale-in">
      <div class="flex justify-center py-8">
        <div class="w-10 h-10 border-4 border-surface-200 border-t-brand-500 rounded-full animate-spin"></div>
      </div>
    </div>

    <!-- Leaderboard -->
    <div id="leaderboard-card" class="card p-6 hidden animate-fade-up" style="animation-delay:0.2s;opacity:0;">
      <h2 class="text-lg font-bold text-surface-900 mb-4 flex items-center gap-2">
        <span class="text-xl">🏆</span> Leaderboard
      </h2>
      <div id="leaderboard" class="divide-y divide-surface-100"></div>
    </div>

    <!-- Your Attempts (saved in your browser) -->
    <div id="history-card" class="card p-6 hidden animate-fade-up" style="animation-delay:0.22s;opacity:0;">
      <h2 class="text-lg font-bold text-surface-900 mb-1 flex items-center gap-2">
        <span class="text-xl">📊</span> Your Attempts
      </h2>
      <p class="text-xs text-surface-400 mb-4">Saved locally in this browser — not on our server.</p>
      <div id="history" class="divide-y divide-surface-100"></div>
    </div>

    <!-- Related Study Resource -->
    <div id="related-blog" class="hidden animate-fade-up" style="animation-delay:0.25s;opacity:0;"></div>

    <!-- Review -->
    <div id="review-card" class="card p-6 hidden animate-fade-up" style="animation-delay:0.3s;opacity:0;">
      <h2 class="text-lg font-bold text-surface-900 mb-5 flex items-center gap-2">
        <span class="text-xl">📝</span> Review Answers
      </h2>
      <div id="review" class="space-y-1"></div>
    </div>
    )}
  </div>

  <script is:inline>
    const labels = ['A','B','C','D'];
    function escapeHtml(val) {
      return String(val ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
    const params = new URLSearchParams(window.location.search);
    const examId = params.get('examId') || '';
    const score = parseInt(params.get('score') || '0', 10) || 0;
    const total = parseInt(params.get('total') || '0', 10) || 0;
    const correctParam = params.get('correct');
    const wrongParam = params.get('wrong');
    const skippedParam = params.get('skipped');
    const penaltyParam = params.get('penalty');

    async function init() {
      try {
        const exRes = await fetch('/api/exam/' + examId);
        const exam = await exRes.json();
        const examTotal = total || exam.totalQuestions;
        const pct = examTotal > 0 ? Math.round(score / examTotal * 100) : 0;
        const grade = pct >= 80 ? 'Excellent' : pct >= 60 ? 'Good' : pct >= 40 ? 'Fair' : 'Needs Work';
        const gradeColor = pct >= 80 ? 'text-emerald-500' : pct >= 60 ? 'text-brand-500' : pct >= 40 ? 'text-amber-500' : 'text-red-500';

        // correct / wrong / skipped / penalty from URL params
        let correctCount = correctParam !== null ? parseInt(correctParam, 10) : 0;
        let wrongCount = wrongParam !== null ? parseInt(wrongParam, 10) : 0;
        let skippedCount = skippedParam !== null ? parseInt(skippedParam, 10) : 0;
        let penaltyAmount = penaltyParam !== null ? parseFloat(penaltyParam) : 0;

        // Fallback: derive from score if params missing (old links)
        if (correctParam === null && wrongParam === null) {
          correctCount = score;
          wrongCount = examTotal - score;
          penaltyAmount = Math.max(0, correctCount - score);
          skippedCount = 0;
        }
        if (correctCount + wrongCount + skippedCount > examTotal) {
          skippedCount = Math.max(0, examTotal - correctCount - wrongCount);
        }

        document.getElementById('result-card').innerHTML = `
          <div class="w-20 h-20 rounded-3xl bg-brand-50 flex items-center justify-center text-4xl mx-auto mb-6">🎯</div>
          <div class="text-sm font-semibold text-surface-400 uppercase tracking-wider mb-2">${grade}</div>
          <div class="text-6xl font-black ${gradeColor} mb-2">${pct}%</div>
          <div class="text-xs text-surface-400 mb-6">Final score after negative marking (4 wrong = −1)</div>

          <!-- Score Breakdown -->
          <div class="bg-surface-50 rounded-2xl p-5 mb-6 text-left max-w-sm mx-auto">
            <div class="space-y-3 text-sm">
              <div class="flex justify-between items-center">
                <span class="flex items-center gap-2 text-surface-600"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> সঠিক উত্তর</span>
                <span class="font-bold text-emerald-600">${correctCount} টি &nbsp;→&nbsp; +${correctCount}.00</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="flex items-center gap-2 text-surface-600"><span class="w-2 h-2 rounded-full bg-red-500"></span> ভুল উত্তর</span>
                <span class="font-bold text-red-500">${wrongCount} টি &nbsp;→&nbsp; −${penaltyAmount.toFixed(2)}</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="flex items-center gap-2 text-surface-600"><span class="w-2 h-2 rounded-full bg-surface-300"></span> বাদ দেওয়া</span>
                <span class="font-bold text-surface-500">${skippedCount} টি &nbsp;→&nbsp; ±0</span>
              </div>
              <div class="border-t border-surface-200 pt-3 flex justify-between items-center">
                <span class="font-semibold text-surface-800">📊 মোট স্কোর</span>
                <span class="font-black text-lg ${gradeColor}">${score} / ${examTotal}</span>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap justify-center gap-3" id="review-actions">
            <button onclick="navigator.share && navigator.share({title:'My Result',url:window.location.href})" class="btn-ghost text-sm px-5 py-2.5">Share</button>
            <button onclick="navigator.clipboard.writeText(window.location.href);window.showToast('Link copied!')" class="btn-ghost text-sm px-5 py-2.5">Copy Link</button>
            <button onclick="window.print()" data-no-print class="btn-ghost text-sm px-5 py-2.5">🖨️ Print</button>
            ${wrongCount>0?`<a href="/exam?id=${examId}&mode=practice" class="btn-primary text-sm px-5 py-2.5">🚩 Practice Wrong (${wrongCount})</a>`:''}
          </div>`;

        // Save progress to localStorage
        try {
          const progressKey = 'examtext_progress_' + examId;
          const existing = JSON.parse(localStorage.getItem(progressKey) || '{}');
          const bestScore = Math.max(existing.bestScore ?? 0, score);
          localStorage.setItem(progressKey, JSON.stringify({
            attempted: true,
            bestScore,
            lastAttempt: new Date().toISOString(),
            totalQuestions: examTotal,
          }));
        } catch {}

        const qRes = await fetch(`/api/exam/${examId}/questions`);
        const questions = await qRes.json();

        // Read this attempt's answers from the student's browser (localStorage)
        let studentAnswers = {};
        try {
          const last = JSON.parse(localStorage.getItem('examtext_last_' + examId) || 'null');
          if (last && last.answers) studentAnswers = last.answers;
        } catch {}

        document.getElementById('review-card').classList.remove('hidden');
        document.getElementById('review').innerHTML = questions.map((q, i) => {
          const studentAns = studentAnswers[i];
          const isCorrect = studentAns === q.correctOptionIndex;
          return `
          <div class="py-4">
            <div class="flex items-start gap-3 mb-3">
              <span class="shrink-0 w-7 h-7 rounded-lg ${isCorrect ? 'bg-emerald-500' : 'bg-red-500'} text-white flex items-center justify-center text-xs font-bold mt-0.5">${i+1}</span>
              <p class="font-medium text-surface-800 leading-relaxed">${q.questionText}</p>
            </div>
            <div class="ml-10 space-y-2">
              ${q.options.map((opt, oi) => {
                let cls = 'border-surface-200';
                if (oi === q.correctOptionIndex) cls = 'border-emerald-500 bg-emerald-50 text-emerald-700';
                else if (oi === studentAns && !isCorrect) cls = 'border-red-500 bg-red-50 text-red-700';
                const icon = oi === q.correctOptionIndex ? ' ✓' : (oi === studentAns && !isCorrect ? ' ✗' : '');
                return `<div class="flex items-center gap-2.5 p-3 border-2 rounded-xl text-sm ${cls}"><span class="font-bold">${labels[oi]}.</span> ${opt}${icon}</div>`;
              }).join('')}
            </div>
            ${q.explanation ? `<div class="ml-10 mt-3 p-4 bg-amber-50 border-l-4 border-amber-400 rounded-xl text-sm text-amber-800">💡 ${q.explanation}</div>` : ''}
          </div>`;
        }).join('');

        const lbRes = await fetch(`/api/leaderboard/${examId}`);
        const attempts = await lbRes.json();
        if (attempts.length > 0) {
          document.getElementById('leaderboard-card').classList.remove('hidden');
          document.getElementById('leaderboard').innerHTML = attempts.map((a, i) => `
            <div class="flex items-center gap-4 py-3">
              <span class="text-lg font-bold w-8 text-center">${i===0?'🥇':i===1?'🥈':i===2?'🥉':'#'+(i+1)}</span>
              <div class="flex-1 min-w-0">
                <span class="font-semibold text-surface-800">${escapeHtml(a.studentName)}</span>
              </div>
              <span class="text-sm font-medium text-surface-500">${a.score}/${a.total} · ${Math.round(a.score/a.total*100)}%</span>
            </div>
          `).join('');
        }

        // Render browser-local attempt history for this exam
        try {
          const all = JSON.parse(localStorage.getItem('examtext_attempts') || '[]');
          const hist = all.filter((a) => a.examId === examId).sort((a, b) => b.date - a.date);
          if (hist.length > 0) {
            document.getElementById('history-card').classList.remove('hidden');
            document.getElementById('history').innerHTML = hist.slice(0, 10).map((a, i) => {
              const pct = a.total > 0 ? Math.round(a.score / a.total * 100) : 0;
              return `<div class="flex items-center gap-3 py-2.5">
                <span class="text-xs font-bold w-6 text-surface-400">#${hist.length - i}</span>
                <span class="text-sm font-semibold text-surface-700 flex-1">${a.score}/${a.total}</span>
                <span class="text-xs font-medium ${pct >= 50 ? 'text-emerald-500' : 'text-amber-500'}">${pct}%</span>
                <span class="text-xs text-surface-300">${new Date(a.date).toLocaleDateString()}</span>
              </div>`;
            }).join('');
          }
        } catch {}

        // Fetch related blog
        try {
          const blogRes = await fetch(`/api/blogs/${exam.subjectId || ''}`);
          if (blogRes.ok) {
            const blogs = await blogRes.json();
            const related = blogs.find((b) => b.examId === examId);
            if (related) {
              document.getElementById('related-blog').classList.remove('hidden');
              document.getElementById('related-blog').innerHTML = `
                <div class="card p-5 border border-brand-200 bg-brand-50/50">
                  <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-brand-600 flex items-center justify-center">
                      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-xs font-semibold text-brand-600 uppercase tracking-wide mb-1">📚 Study Resource</p>
                      <h3 class="font-semibold text-surface-900 text-sm leading-snug mb-1">${related.title}</h3>
                      ${related.description ? `<p class="text-xs text-surface-500 mb-3">${related.description}</p>` : ''}
                      <a href="/blog?id=${related.id}" class="btn-primary text-xs px-4 py-2 inline-flex items-center gap-1.5">
                        বিস্তারিত পড়ুন <span>→</span>
                      </a>
                    </div>
                  </div>
                </div>`;
            }
          }
        } catch {}
      } catch(e) { console.error(e); }
    }
    init();
  </script>
</Layout>
