---
import Layout from '../layouts/Layout.astro';
import { getAdminDb } from '../lib/firebase-admin';

const blogId = Astro.url.searchParams.get('id') || '';
let blog: any = null;
let examTitle = '';

try {
  const db = getAdminDb();
  const snap = await db.collection('blogs').doc(blogId).get();
  if (snap.exists) {
    const data = snap.data()!;
    if (!data.published) {
      return Astro.redirect('/');
    }
    blog = { id: snap.id, ...data };
    if (blog.examId) {
      const examSnap = await db.collection('exams').doc(blog.examId).get();
      if (examSnap.exists) examTitle = examSnap.data()!.title || '';
    }
  }
} catch {}

if (!blog) return Astro.redirect('/');
---
<Layout title={`${blog.title} - ExamText`} navBack={true} navTitle={blog.title}>
  <div class="max-w-3xl mx-auto px-4 py-10">

    <!-- Header -->
    <div class="mb-8 animate-fade-up">
      <div class="flex items-center gap-3 mb-4">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center">
          <svg class="w-6 h-6 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
        </div>
        <div>
          <span class="inline-block px-2.5 py-0.5 bg-brand-50 text-brand-600 text-xs font-bold rounded-full uppercase tracking-wide">Study Resource</span>
        </div>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-surface-900 mb-3">{blog.title}</h1>
      {blog.description && <p class="text-surface-400 text-base leading-relaxed mb-4">{blog.description}</p>}
      <div class="flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-surface-100 text-surface-500">
          📝 {blog.content?.length || 0} Q&A
        </span>
        {examTitle && (
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-surface-100 text-surface-500">
            📖 {examTitle}
          </span>
        )}
      </div>
    </div>

    <!-- Slide Deck -->
    {blog.slideUrl && (
      <div class="card p-5 border border-brand-200 bg-brand-50/50 mb-8 animate-fade-up" style="animation-delay:0.08s;opacity:0;">
        <div class="flex items-center gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-brand-600 flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-surface-900 text-sm">📊 Slide Deck (NotebookLM)</p>
            <p class="text-xs text-surface-400 mt-0.5">Interactive slides for this chapter</p>
          </div>
          <a href={blog.slideUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs px-4 py-2 inline-flex items-center gap-1.5 shrink-0">
            Open Slides
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    )}

    <!-- Q&A Section -->
    <div class="mb-6 animate-fade-up" style="animation-delay:0.12s;opacity:0;">
      <h2 class="text-lg font-bold text-surface-900 mb-4">
        <span class="font-bengali">{blog.content?.length || 0} টি প্রশ্নোত্তর</span>
      </h2>
    </div>

    <div class="space-y-3">
      {(blog.content || []).map((item: any, i: number) => (
        <details class="card overflow-hidden group animate-fade-up" style={`animation-delay:${0.15 + i * 0.03}s;opacity:0;`}>
          <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer select-none hover:bg-surface-50 transition-colors list-none">
            <span class="shrink-0 w-7 h-7 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center text-xs font-bold">{i + 1}</span>
            <span class="flex-1 text-sm font-semibold text-surface-800 leading-snug">{item.question}</span>
            <svg class="w-4 h-4 text-surface-300 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-4 pt-0 ml-10">
            <p class="text-sm text-surface-600 leading-relaxed whitespace-pre-line">{item.answer}</p>
            {item.tags && item.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-3">
                {item.tags.map((tag: string) => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-surface-100 text-surface-400 font-medium">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </details>
      ))}
    </div>

    <!-- Footer CTA -->
    {blog.examId && (
      <div class="mt-10 text-center animate-fade-up" style="animation-delay:0.3s;opacity:0;">
        <a href={`/exam-intro/${blog.examId}`} class="btn-primary text-sm px-8 py-3 inline-flex items-center gap-2">
          এই চ্যাপ্টারের পরীক্ষা দিন
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    )}
  </div>
</Layout>
