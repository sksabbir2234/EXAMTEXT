(() => {
      const gate = document.getElementById('gate');
      const content = document.getElementById('admin-content');
      const gateForm = document.getElementById('gate-form');
      const gatePass = document.getElementById('gate-pass');
      const gateError = document.getElementById('gate-error');
      const gateBtn = document.getElementById('gate-btn');

      // --- Auth ---
      async function tryAutoAuth() {
        try {
          const res = await fetch('/api/admin/session');
          const data = await res.json();
          if (data.authed) { gate.classList.add('hidden'); content.classList.remove('hidden'); loadManageList(); }
        } catch {}
      }
      tryAutoAuth();

      gateForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        gateBtn.disabled = true; gateBtn.textContent = '...';
        gateError.classList.add('hidden');
        try {
          const res = await fetch('/api/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: gatePass.value }) });
          if (res.ok) {
            gate.classList.add('hidden');
            content.classList.remove('hidden');
            loadManageList();
          } else {
            const d = await res.json();
            gateError.textContent = d.error || 'Wrong password';
            gateError.classList.remove('hidden');
          }
        } catch (e) { gateError.textContent = 'Connection error'; gateError.classList.remove('hidden'); }
        gateBtn.disabled = false; gateBtn.textContent = 'Unlock';
      });

      document.getElementById('lock-btn').addEventListener('click', async () => {
        await fetch('/api/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'logout' }) });
        content.classList.add('hidden');
        gate.classList.remove('hidden');
        gatePass.value = '';
      });

      // --- Tabs ---
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');
      let currentTab = 'upload';

      document.querySelectorAll('[data-tab]').forEach(btn => {
        btn.addEventListener('click', () => {
          currentTab = btn.dataset.tab;
          tabBtns.forEach(b => { b.classList.toggle('bg-white', b.dataset.tab === currentTab); b.classList.toggle('shadow-sm', b.dataset.tab === currentTab); b.classList.toggle('text-brand-600', b.dataset.tab === currentTab); b.classList.toggle('text-surface-500', b.dataset.tab !== currentTab); });
          tabContents.forEach(c => c.classList.toggle('hidden', c.id !== 'tab-' + currentTab));
          if (currentTab === 'manage') loadManageList();
        });
      });

      // --- Confirm Modal ---
      let modalResolve = null;
      function showConfirm(title, desc, confirmText = 'Delete') {
        return new Promise(resolve => {
          modalResolve = resolve;
          document.getElementById('modal-title').textContent = title;
          document.getElementById('modal-desc').textContent = desc;
          document.getElementById('modal-confirm').textContent = confirmText;
          document.getElementById('confirm-modal').classList.remove('hidden');
        });
      }
      document.getElementById('modal-cancel').addEventListener('click', () => { document.getElementById('confirm-modal').classList.add('hidden'); if (modalResolve) modalResolve(false); });
      document.getElementById('modal-backdrop').addEventListener('click', () => { document.getElementById('confirm-modal').classList.add('hidden'); if (modalResolve) modalResolve(false); });
      document.getElementById('modal-confirm').addEventListener('click', () => { document.getElementById('confirm-modal').classList.add('hidden'); if (modalResolve) modalResolve(true); });

      // --- Upload Tab ---
      let parsedData = null;
      let editMode = null; // null = new, string = exam id being edited
      const labels = ['A','B','C','D'];
      const jsonText = document.getElementById('json-text');
      const dropZone = document.getElementById('drop-zone');
      const qCounter = document.getElementById('q-counter');
      const qStatus = document.getElementById('q-status');
      const validationErrors = document.getElementById('validation-errors');
      const liveValidation = document.getElementById('live-validation');
      const uploadSubtitle = document.getElementById('upload-subtitle');

      function escapeHtml(value) {
        return String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      // File queue for batch upload
      let examFileQueue = [];
      const fileQueueEl = document.getElementById('file-queue');
      const queueListEl = document.getElementById('queue-list');
      const queueCountEl = document.getElementById('queue-count');

      function renderExamQueue() {
        if (examFileQueue.length === 0) { fileQueueEl.classList.add('hidden'); return; }
        fileQueueEl.classList.remove('hidden');
        queueCountEl.textContent = examFileQueue.length + ' file' + (examFileQueue.length !== 1 ? 's' : '');
        queueListEl.innerHTML = examFileQueue.map((f, i) => {
          const statusCls = f.status === 'done' ? 'text-emerald-500' : f.status === 'error' ? 'text-red-500' : f.status === 'uploading' ? 'text-brand-500' : 'text-surface-400';
          const statusText = f.status === 'done' ? '✓ Done' : f.status === 'error' ? '✗ ' + (f.error || 'Error') : f.status === 'uploading' ? '...' : 'Pending';
          const canReorder = f.status === 'pending';
          const upBtn = canReorder && i > 0 ? '<button onclick="moveExamQueue(' + i + ',-1)" class="text-surface-300 hover:text-brand-500 shrink-0 text-xs" title="Move up">▲</button>' : '<span class="w-3"></span>';
          const downBtn = canReorder && i < examFileQueue.length - 1 ? '<button onclick="moveExamQueue(' + i + ',1)" class="text-surface-300 hover:text-brand-500 shrink-0 text-xs" title="Move down">▼</button>' : '<span class="w-3"></span>';
          return '<div class="flex items-center gap-1.5 p-2 bg-surface-50 rounded-xl text-sm"><span class="text-xs font-bold text-surface-300 w-4 text-center shrink-0">' + (i + 1) + '</span>' + upBtn + downBtn + '<span class="truncate flex-1 text-surface-700">' + escapeHtml(f.name) + '</span><span class="text-xs ' + statusCls + '">' + escapeHtml(statusText) + '</span><button onclick="removeExamQueue(' + i + ')" class="text-surface-300 hover:text-red-500 shrink-0 text-xs" title="Remove">✕</button></div>';
        }).join('');
      }
      window.removeExamQueue = (i) => { examFileQueue.splice(i, 1); renderExamQueue(); };
      window.moveExamQueue = (i, dir) => {
        const j = i + dir;
        if (j < 0 || j >= examFileQueue.length) return;
        const temp = examFileQueue[i];
        examFileQueue[i] = examFileQueue[j];
        examFileQueue[j] = temp;
        renderExamQueue();
      };
      document.getElementById('queue-clear').addEventListener('click', () => { examFileQueue = []; renderExamQueue(); });

      // Add files to queue from input
      function addExamFiles(files) {
        for (const f of files) {
          if (!f.name.endsWith('.json')) continue;
          const reader = new FileReader();
          reader.onload = ev => {
            examFileQueue.push({ name: f.name, content: ev.target.result, status: 'pending' });
            renderExamQueue();
          };
          reader.readAsText(f);
        }
      }

      // Drag & drop (single or multi)
      ['dragenter','dragover'].forEach(e => dropZone.addEventListener(e, ev => { ev.preventDefault(); dropZone.classList.add('border-brand-400','bg-brand-50/30'); }));
      ['dragleave','drop'].forEach(e => dropZone.addEventListener(e, ev => { ev.preventDefault(); dropZone.classList.remove('border-brand-400','bg-brand-50/30'); }));
      dropZone.addEventListener('drop', e => {
        const files = e.dataTransfer?.files;
        if (files && files.length > 1) { addExamFiles(files); return; }
        if (files && files.length === 1) { readFile(files[0]); }
      });
      document.getElementById('json-file').addEventListener('change', e => {
        const files = e.target.files;
        if (files.length > 1) { addExamFiles(files); e.target.value = ''; return; }
        if (files[0]) readFile(files[0]);
        e.target.value = '';
      });

      function readFile(file) {
        const reader = new FileReader();
        reader.onload = ev => { jsonText.value = ev.target.result; validateLive(); };
        reader.readAsText(file);
      }

      function validateQuestions(questions) {
        const errs = [];
        if (!Array.isArray(questions) || questions.length === 0) { errs.push('questions must be a non-empty array'); return errs; }
        questions.forEach((q, i) => {
          const n = i + 1;
          if (!q.questionText || typeof q.questionText !== 'string') errs.push(`Q${n}: missing questionText`);
          if (!Array.isArray(q.options) || q.options.length < 2) errs.push(`Q${n}: needs ≥2 options`);
          if (typeof q.correctOptionIndex !== 'number' || q.correctOptionIndex < 0 || (Array.isArray(q.options) && q.correctOptionIndex >= q.options.length)) errs.push(`Q${n}: correctOptionIndex out of range`);
        });
        return errs;
      }

      let debounceTimer;
      jsonText.addEventListener('input', () => { clearTimeout(debounceTimer); debounceTimer = setTimeout(validateLive, 300); });

      function validateLive() {
        const raw = jsonText.value.trim();
        if (!raw) { liveValidation.classList.add('hidden'); return; }
        try {
          const data = JSON.parse(raw);
          const errs = validateQuestions(data.questions || []);
          const count = Array.isArray(data.questions) ? data.questions.length : 0;
          qCounter.textContent = `${count} question${count !== 1 ? 's' : ''}`;
          if (errs.length === 0 && count > 0) {
            qStatus.textContent = 'Valid';
            qStatus.className = 'text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600';
            validationErrors.innerHTML = '';
          } else {
            qStatus.textContent = `${errs.length} error${errs.length !== 1 ? 's' : ''}`;
            qStatus.className = 'text-xs font-semibold px-2 py-0.5 rounded-full bg-red-50 text-red-600';
            validationErrors.innerHTML = errs.map(e => `<div class="text-xs text-red-500 flex items-center gap-1.5"><svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm-1-5h2V5H9v8zm0 4h2v-2H9v2z" clip-rule="evenodd"/></svg><span>${escapeHtml(e)}</span></div>`).join('');
          }
          liveValidation.classList.remove('hidden');
        } catch {
          qCounter.textContent = '';
          qStatus.textContent = 'Invalid JSON';
          qStatus.className = 'text-xs font-semibold px-2 py-0.5 rounded-full bg-red-50 text-red-600';
          validationErrors.innerHTML = '<div class="text-xs text-red-500">Cannot parse JSON</div>';
          liveValidation.classList.remove('hidden');
        }
      }

      // Preview
      document.getElementById('preview-btn').addEventListener('click', () => {
        try {
          parsedData = JSON.parse(jsonText.value.trim());
          const errs = validateQuestions(parsedData.questions || []);
          if (errs.length > 0) { window.showToast(errs[0]); parsedData = null; return; }
          if (!parsedData.questions || !parsedData.questions.length) { window.showToast('No questions'); parsedData = null; return; }

          let html = `<div class="grid grid-cols-2 gap-3 mb-4 text-sm"><div><strong>Subject:</strong> ${escapeHtml(parsedData.subject || '-')}</div><div><strong>Title:</strong> ${escapeHtml(parsedData.examTitle || '-')}</div></div>`;
          html += `<div class="text-xs text-surface-500 mb-3">Duration: ${escapeHtml(String(parsedData.durationMinutes || 0))} min</div>`;

          parsedData.questions.forEach((q, i) => {
            html += `<div class="mb-3 pb-3 border-b border-surface-200 last:border-0"><div class="font-semibold text-sm mb-1">Q${i + 1}: ${escapeHtml(q.questionText || '')}</div>`;
            q.options.forEach((opt, oi) => {
              const isCorrect = oi === q.correctOptionIndex;
              const prefix = labels[oi] || (oi + 1);
              html += `<div class="text-sm ml-4 ${isCorrect ? 'text-emerald-600 font-semibold' : ''}">${escapeHtml(prefix)}. ${escapeHtml(opt || '')}${isCorrect ? ' ✅' : ''}</div>`;
            });
            if (q.explanation) html += `<div class="text-xs text-surface-400 mt-1 ml-4">💡 ${escapeHtml(q.explanation)}</div>`;
            html += '</div>';
          });

          document.getElementById('preview-content').innerHTML = html;
          document.getElementById('preview-area').classList.remove('hidden');
        } catch(e) { window.showToast('Invalid JSON: ' + e.message); parsedData = null; }
      });

      document.getElementById('cancel-preview').addEventListener('click', () => { document.getElementById('preview-area').classList.add('hidden'); parsedData = null; });
      document.getElementById('clear-btn').addEventListener('click', () => { jsonText.value = ''; parsedData = null; editMode = null; uploadSubtitle.textContent = 'Paste JSON or drop a file'; liveValidation.classList.add('hidden'); document.getElementById('preview-area').classList.add('hidden'); document.getElementById('upload-result').innerHTML = ''; });

      // Confirm upload
      document.getElementById('confirm-btn').addEventListener('click', async () => {
        if (!parsedData) return;
        const btn = document.getElementById('confirm-btn');
        btn.disabled = true; btn.textContent = editMode ? 'Saving...' : 'Uploading...';
        try {
          let res;
          if (editMode) {
            res = await fetch(`/api/admin/exam/${editMode}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ examTitle: parsedData.examTitle, durationMinutes: parsedData.durationMinutes, totalQuestions: parsedData.questions.length, questions: parsedData.questions }) });
          } else {
            res = await fetch('/api/admin/upload', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(parsedData) });
          }
          const data = await res.json();
          if (res.ok) {
            let msg = editMode ? 'Exam updated!' : 'Uploaded!';
            if (data.warning) msg += ' ⚠️ ' + data.warning;
            const url = window.location.origin + '/exam-intro/' + (data.id || editMode);
            document.getElementById('upload-result').innerHTML = `<div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl"><h3 class="font-bold text-emerald-700 mb-2">${escapeHtml(msg)}</h3><div class="flex gap-2"><input value="${escapeHtml(url)}" readonly class="flex-1 px-3 py-2 border border-emerald-200 rounded-xl text-sm bg-white" /><button onclick="navigator.clipboard.writeText('${escapeHtml(url)}'); window.showToast('Copied!')" class="px-4 py-2 bg-emerald-500 text-white rounded-xl text-sm font-semibold">Copy</button></div></div>`;
            window.showToast(editMode ? 'Exam updated' : 'Exam uploaded');
            editMode = null;
            jsonText.value = '';
            parsedData = null;
            document.getElementById('preview-area').classList.add('hidden');
            document.getElementById('json-file').value = '';
            uploadSubtitle.textContent = 'Paste JSON or drop a file';
            liveValidation.classList.add('hidden');
            loadManageList();
          } else {
            let errMsg = data.error || 'Upload failed';
            if (data.details) errMsg += ': ' + data.details.join('; ');
            document.getElementById('upload-result').innerHTML = `<p class="text-red-500 text-sm">${escapeHtml(errMsg)}</p>`;
            window.showToast('Upload failed');
          }
        } catch(e) { document.getElementById('upload-result').innerHTML = `<p class="text-red-500 text-sm">${escapeHtml(e.message)}</p>`; window.showToast('Error'); }
        btn.disabled = false; btn.textContent = editMode ? 'Save Changes' : 'Confirm Upload';
      });

      // Batch upload all queued exam files
      document.getElementById('upload-all-btn').addEventListener('click', async () => {
        const pending = examFileQueue.filter(f => f.status === 'pending');
        if (pending.length === 0) { window.showToast('No pending files'); return; }
        const btn = document.getElementById('upload-all-btn');
        btn.disabled = true; btn.textContent = 'Uploading...';
        document.getElementById('batch-progress').classList.remove('hidden');
        let done = 0;
        const total = pending.length;
        for (const f of pending) {
          f.status = 'uploading'; renderExamQueue();
          document.getElementById('batch-status').textContent = 'Uploading ' + f.name + ' (' + (done + 1) + '/' + total + ')';
          document.getElementById('batch-bar').style.width = Math.round((done / total) * 100) + '%';
          try {
            const parsed = JSON.parse(f.content);
            const res = await fetch('/api/admin/upload', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(parsed) });
            const data = await res.json();
            if (res.ok) { f.status = 'done'; } else { f.status = 'error'; f.error = data.error || 'Failed'; }
          } catch (e) { f.status = 'error'; f.error = e.message; }
          done++;
          document.getElementById('batch-bar').style.width = Math.round((done / total) * 100) + '%';
          renderExamQueue();
        }
        document.getElementById('batch-status').textContent = 'Done! ' + examFileQueue.filter(f => f.status === 'done').length + '/' + total + ' uploaded';
        document.getElementById('batch-bar').style.width = '100%';
        btn.disabled = false; btn.textContent = 'Upload All';
        window.showToast('Batch upload complete');
        loadManageList();
        setTimeout(() => { document.getElementById('batch-progress').classList.add('hidden'); }, 3000);
      });

      document.getElementById('preview-content').classList.remove('max-h-[400px]');
      document.getElementById('preview-content').classList.add('max-h-[80vh]');
    })();
