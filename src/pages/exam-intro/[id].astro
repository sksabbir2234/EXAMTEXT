---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { doc, getDoc } from 'firebase/firestore';
import { db } from '../../lib/firebase';

const { id } = Astro.params;
let exam: any = { title: 'Exam', totalQuestions: 0, durationMinutes: 0, subjectName: '' };

try {
  const snap = await getDoc(doc(db, 'exams', id!));
  if (snap.exists()) {
    exam = { id: snap.id, ...snap.data() };
    try {
      const subSnap = await getDoc(doc(db, 'subjects', exam.subjectId));
      if (subSnap.exists()) exam.subjectName = subSnap.data().name;
    } catch {}
  }
} catch {}
---
<Layout
  title={`${exam.title} - ExamText`}
  ogTitle={`${exam.title} - ExamText`}
  ogDescription={`${exam.totalQuestions} questions | ${exam.durationMinutes || 0} min | Take this exam now!`}
  navBack={true}
  navTitle={exam.title}
>
  <div class="max-w-lg mx-auto px-4 py-12">
    <!-- Exam Info Card -->
    <div class="card p-8 text-center mb-6 animate-scale-in">
      <div class="w-16 h-16 rounded-2xl bg-brand-50 flex items-center justify-center text-3xl mx-auto mb-6">📋</div>
      <h1 class="text-2xl font-bold text-surface-900 mb-2">{exam.title}</h1>
      <p class="text-surface-400 text-sm mb-8">{exam.subjectName}</p>
      <div class="flex justify-center gap-16">
        <div>
          <div class="text-4xl font-black text-brand-600">{exam.totalQuestions}</div>
          <div class="text-xs font-medium text-surface-400 uppercase tracking-wider mt-1">Questions</div>
        </div>
        <div>
          <div class="text-4xl font-black text-brand-600">{exam.durationMinutes > 0 ? `${exam.durationMinutes}m` : '∞'}</div>
          <div class="text-xs font-medium text-surface-400 uppercase tracking-wider mt-1">Duration</div>
        </div>
      </div>
    </div>

    <!-- Name Form -->
    <div class="card p-8 animate-fade-up" style="animation-delay:0.15s;opacity:0;">
      <h2 class="text-lg font-bold text-surface-900 mb-1">Before you begin</h2>
      <p class="text-surface-400 text-sm mb-6">Enter your name to start the exam</p>
      <form id="name-form" class="space-y-4">
        <input type="text" id="student-name" placeholder="Your name" required autocomplete="name"
               class="w-full px-4 py-3.5 rounded-2xl border-2 border-surface-200 focus:border-brand-500 focus:ring-0 outline-none transition font-medium text-surface-800 placeholder:text-surface-300">
        <button type="submit" class="w-full py-4 bg-brand-600 text-white rounded-2xl font-bold text-lg hover:bg-brand-700 hover:shadow-glow active:scale-[0.98] transition-all duration-200">
          Start Exam
        </button>
      </form>
    </div>
  </div>
  <script is:inline define:vars={{ examId: id }}>
    const form = document.getElementById('name-form');
    const nameInput = document.getElementById('student-name');
    const saved = sessionStorage.getItem('studentName');
    if (saved) nameInput.value = saved;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = nameInput.value.trim();
      if (!name) return;
      sessionStorage.setItem('studentName', name);
      window.location.href = `/exam?id=${examId}`;
    });
  </script>
</Layout>
