---
import Layout from '../layouts/Layout.astro';
import { getAdminDb } from '../lib/firebase-admin';

const subjectId = Astro.url.searchParams.get('id') || '';

function slugToTitle(slug: string): string {
  return slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

let subjectName = slugToTitle(subjectId);
let exams: any[] = [];
let fetchError = false;

// Blog map (examId → {id, title})
let blogsByExamId = new Map<string, { id: string; title: string }>();

try {
  const db = getAdminDb();

  // Fetch subject name
  try {
    const subDoc = await db.collection('subjects').doc(subjectId).get();
    if (subDoc.exists && subDoc.data()!.name) {
      subjectName = subDoc.data()!.name;
    }
  } catch (err) {
    console.error('[subject.astro] subject fetch error:', err);
  }

  // Fetch published exams (no composite index — single query + JS filter)
  try {
    const snap = await db.collection('exams')
      .where('subjectId', '==', subjectId)
      .get();
    exams = snap.docs
      .map(d => ({ id: d.id, ...d.data() }))
      .filter(e => e.published === true);
  } catch (err) {
    console.error('[subject.astro] exams fetch error:', err);
    fetchError = true;
  }

  // Sort by chapter number — compute once, sort deterministically
  const getNum = (title: string): number => {
    const m = (title || '').match(/Chapter\s+(\d+)/i);
    return m ? parseInt(m[1], 10) : 999;
  };
  exams = exams
    .map(e => ({ ...e, _chapterNum: getNum(e.title) }))
    .sort((a, b) => a._chapterNum - b._chapterNum)
    .map((e, i) => ({ ...e, chapterNum: e._chapterNum || i + 1 }));

  // Fetch published blogs (no composite index needed)
  try {
    const blogsSnap = await db.collection('blogs').where('published', '==', true).get();
    blogsSnap.docs.forEach(doc => {
      const data = doc.data();
      if (data.subjectId === subjectId && data.examId) {
        blogsByExamId.set(data.examId, { id: doc.id, title: data.title });
      }
    });
  } catch {
    // Blog collection may not exist yet
  }
} catch (err) {
  console.error('[subject.astro] Fatal error:', err);
  fetchError = true;
}
---
<Layout title={`${subjectName} - ExamText`} navBack={true} navTitle={subjectName}>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-surface-900 mb-2">{subjectName}</h1>
      <p class="text-surface-400">{exams.length} chapter{exams.length !== 1 ? 's' : ''} · {exams.reduce((a, e) => a + (e.totalQuestions || 0), 0)} total questions</p>
      <div class="flex justify-center gap-2 mt-4">
        <div class="h-1.5 w-16 bg-brand-500 rounded-full"></div>
        <div class="h-1.5 w-8 bg-brand-200 rounded-full"></div>
        <div class="h-1.5 w-4 bg-brand-100 rounded-full"></div>
      </div>
    </div>

    <!-- Progress bar (client-side) -->
    <div class="mb-6 bg-brand-50 border border-brand-100 rounded-2xl p-4 hidden" id="progress-summary">
      <div class="flex justify-between text-sm text-surface-500 mb-2">
        <span class="font-medium">Your Progress</span>
        <span id="progress-text" class="font-semibold text-brand-600">0 of {exams.length} chapters attempted</span>
      </div>
      <div class="h-2 bg-brand-100 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-gradient-to-r from-brand-500 to-emerald-500 rounded-full transition-all duration-700" style="width: 0%"></div>
      </div>
    </div>

    {fetchError && (
      <div class="card p-6 text-center text-surface-500">
        <div class="w-16 h-16 rounded-3xl bg-red-50 flex items-center justify-center text-3xl mx-auto mb-4">⚠️</div>
        <p class="font-medium">Unable to load exams right now.</p>
        <p class="text-sm mt-1">Please refresh the page.</p>
        <button onclick="window.location.reload()" class="btn-ghost text-sm mt-3">Retry</button>
      </div>
    )}

    {!fetchError && exams.length === 0 && (
      <div class="text-center py-20">
        <div class="w-20 h-20 rounded-3xl bg-surface-100 flex items-center justify-center text-4xl mx-auto mb-6">📭</div>
        <h3 class="text-xl font-semibold text-surface-700 mb-2">No exams available</h3>
        <p class="text-surface-400">Check back later for new chapters</p>
      </div>
    )}

    {!fetchError && exams.length > 0 && (
      <div class="relative">
        <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gradient-to-b from-brand-500 via-brand-300 to-surface-200 hidden sm:block"></div>

        <div class="space-y-6">
          {exams.map((e, i) => (
            <div class="relative flex gap-5 animate-fade-up" style={`animation-delay:${i * 0.08}s;opacity:0;`} data-exam-id={e.id}>
              <div class="hidden sm:flex shrink-0 w-12 h-12 rounded-2xl bg-brand-500 text-white items-center justify-center text-sm font-bold z-10 shadow-glow">
                {e.chapterNum}
              </div>

              <div class="flex-1 card p-6 hover:border-brand-200 hover:shadow-card-hover transition-all duration-200 group">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="sm:hidden inline-flex w-7 h-7 rounded-lg bg-brand-500 text-white items-center justify-center text-xs font-bold">{e.chapterNum}</span>
                      <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-2 py-0.5 rounded-full">Chapter {e.chapterNum}</span>
                      <span class="progress-badge hidden text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full"></span>
                    </div>
                    <h3 class="text-lg font-bold text-surface-900 mb-2 group-hover:text-brand-700 transition-colors">{e.title}</h3>
                    <div class="flex flex-wrap items-center gap-3 text-sm text-surface-400">
                      <span class="flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        {e.totalQuestions} Q
                      </span>
                      <span class="flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        {e.durationMinutes || 0}m
                      </span>
                    </div>
                    {blogsByExamId.has(e.id) && (
                      <a href={`/blog?id=${blogsByExamId.get(e.id)!.id}`} class="inline-flex items-center gap-2 mt-2 px-3 py-1.5 bg-amber-50 border border-amber-200 rounded-lg text-xs font-medium text-amber-700 hover:bg-amber-100 hover:border-amber-300 transition group/resource">
                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
                        <span class="truncate max-w-[160px]">{blogsByExamId.get(e.id)!.title}</span>
                        <svg class="w-3 h-3 opacity-50 group-hover/resource:opacity-100 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      </a>
                    )}
                  </div>
                  <div class="flex gap-2 shrink-0">
                    <a href={`/exam-intro/${e.id}`} class="btn-primary text-sm px-5 py-2.5">Start</a>
                    <button onclick={`navigator.share ? navigator.share({title:'${e.title}',url:window.location.origin+'/exam-intro/${e.id}'}) : navigator.clipboard.writeText(window.location.origin+'/exam-intro/${e.id}');window.showToast('Link copied!')`}
                            class="btn-ghost text-sm px-3 py-2.5">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="flex gap-5 mt-6">
          <div class="hidden sm:flex shrink-0 w-12 h-12 rounded-2xl bg-surface-200 text-surface-400 items-center justify-center text-sm font-bold z-10">✓</div>
          <div class="flex-1 py-4 text-center text-sm font-medium text-surface-400">{exams.length} chapters available</div>
        </div>
      </div>
    )}
  </div>

  <script is:inline>
    (function() {
      const cards = document.querySelectorAll('[data-exam-id]');
      const total = cards.length;
      let attempted = 0;

      cards.forEach(card => {
        const examId = card.getAttribute('data-exam-id');
        const saved = JSON.parse(localStorage.getItem('examtext_progress_' + examId) || '{}');
        if (saved.attempted) {
          attempted++;
          const badge = card.querySelector('.progress-badge');
          if (badge) {
            badge.textContent = '✓ Best: ' + saved.bestScore + '/' + saved.totalQuestions;
            badge.classList.remove('hidden');
          }
        }
      });

      if (attempted > 0) {
        const summary = document.getElementById('progress-summary');
        summary.classList.remove('hidden');
        document.getElementById('progress-text').textContent = attempted + ' of ' + total + ' chapters attempted';
        document.getElementById('progress-bar').style.width = (attempted / total * 100) + '%';
      }
    })();
  </script>
</Layout>
