---
import Layout from '../layouts/Layout.astro';
import { getAdminDb } from '../lib/firebase-admin';

let blogs: any[] = [];
let fetchError = false;

try {
  const db = getAdminDb();
  const snap = await db.collection('blogs').where('published', '==', true).get();
  blogs = snap.docs.map(d => ({ id: d.id, ...d.data() }));

  const subIds = [...new Set(blogs.map(b => b.subjectId).filter(Boolean))];
  const subNames: Record<string, string> = {};
  for (const sid of subIds) {
    try {
      const s = await db.collection('subjects').doc(sid).get();
      if (s.exists) subNames[sid] = s.data()!.name || sid;
    } catch { subNames[sid] = sid; }
  }
  blogs = blogs.map(b => ({ ...b, subjectName: subNames[b.subjectId] || 'Uncategorized' }));

  blogs.sort((a, b) => {
    const ta = a.createdAt?._seconds || a.createdAt?.seconds || 0;
    const tb = b.createdAt?._seconds || b.createdAt?.seconds || 0;
    return tb - ta;
  });
} catch (err) {
  console.error('[blogs.astro] Error:', err);
  fetchError = true;
}

// Group blogs by subject
const folders: Record<string, { name: string; blogs: any[] }> = {};
for (const b of blogs) {
  const key = b.subjectId || 'uncategorized';
  if (!folders[key]) folders[key] = { name: b.subjectName || key, blogs: [] };
  folders[key].blogs.push(b);
}
const folderKeys = Object.keys(folders);
---
<Layout title="Study Resources - ExamText" navBack={true} navTitle="Study Resources">
  <div class="max-w-3xl mx-auto px-4 py-10">
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-surface-900 mb-2">📚 Study Resources</h1>
      <p class="text-surface-400">Bangla Q&A guides organized by subject</p>
      <div class="flex justify-center gap-2 mt-4">
        <div class="h-1.5 w-16 bg-brand-500 rounded-full"></div>
        <div class="h-1.5 w-8 bg-brand-200 rounded-full"></div>
        <div class="h-1.5 w-4 bg-brand-100 rounded-full"></div>
      </div>
    </div>

    {fetchError ? (
      <div class="card p-8 text-center animate-scale-in">
        <div class="w-16 h-16 rounded-3xl bg-red-50 flex items-center justify-center text-3xl mx-auto mb-6">⚠️</div>
        <h2 class="text-lg font-bold text-surface-900 mb-2">Unable to load resources</h2>
        <p class="text-surface-400 text-sm mb-6">Please refresh the page.</p>
        <button onclick="window.location.reload()" class="btn-primary text-sm px-6 py-3">Retry</button>
      </div>
    ) : folderKeys.length === 0 ? (
      <div class="card p-8 text-center animate-scale-in">
        <div class="w-16 h-16 rounded-3xl bg-brand-50 flex items-center justify-center text-3xl mx-auto mb-6">📖</div>
        <h2 class="text-lg font-bold text-surface-900 mb-2">No resources yet</h2>
        <p class="text-surface-400 text-sm mb-6">Study resources will appear here once published.</p>
        <a href="/" class="btn-primary text-sm px-6 py-3 inline-block">Go Home</a>
      </div>
    ) : (
      <div class="space-y-4" id="folders-container">
        {folderKeys.map((key, fi) => {
          const folder = folders[key];
          return (
            <div class="card overflow-hidden animate-fade-up folder-card" style={`animation-delay:${fi * 0.08}s;opacity:0;`} data-folder={key}>
              <!-- Folder Header -->
              <button class="folder-toggle w-full px-5 py-4 flex items-center gap-3 hover:bg-surface-50 transition text-left cursor-pointer" data-folder={key}>
                <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center">
                  <svg class="w-6 h-6 text-amber-500 folder-icon" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-surface-900 text-sm md:text-base">{folder.name}</h3>
                  <p class="text-xs text-surface-400 mt-0.5">{folder.blogs.length} resource{folder.blogs.length !== 1 ? 's' : ''}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-brand-50 text-brand-600">{folder.blogs.reduce((a, b) => a + (b.content?.length || 0), 0)} Q&A</span>
                  <svg class="w-5 h-5 text-surface-300 transition-transform folder-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
              </button>

              <!-- Folder Contents (hidden by default) -->
              <div class="folder-contents hidden border-t border-surface-100">
                {folder.blogs.map((blog, bi) => (
                  <a href={`/blog?id=${blog.id}`} class="flex items-center gap-3 px-5 py-3 hover:bg-brand-50/50 transition border-b border-surface-50 last:border-0 group file-item">
                    <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-surface-100 group-hover:bg-brand-100 flex items-center justify-center transition-colors">
                      <svg class="w-4 h-4 text-surface-400 group-hover:text-brand-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-semibold text-surface-800 group-hover:text-brand-700 transition-colors truncate">{blog.title}</h4>
                      <div class="flex items-center gap-2 text-xs text-surface-400 mt-0.5">
                        <span>{blog.content?.length || 0} Q&A</span>
                        {blog.slideUrl && <span class="text-emerald-500">• Slides</span>}
                      </div>
                    </div>
                    <svg class="w-4 h-4 text-surface-300 group-hover:text-brand-500 shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>

  <script is:inline>
    (() => {
      document.querySelectorAll('.folder-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.folder;
          const card = btn.closest('.folder-card');
          const contents = card.querySelector('.folder-contents');
          const chevron = card.querySelector('.folder-chevron');
          const icon = card.querySelector('.folder-icon');
          contents.classList.toggle('hidden');
          if (chevron) chevron.style.transform = contents.classList.contains('hidden') ? '' : 'rotate(180deg)';
          if (icon) icon.style.color = contents.classList.contains('hidden') ? '' : '#f59e0b';
        });
      });
    })();
  </script>
</Layout>
