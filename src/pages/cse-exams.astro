---
import Layout from '../layouts/Layout.astro';
---
<Layout title="CSE College Teacher - ExamText" ogTitle="CSE College Teacher Exams" ogDescription="10 chapters × 30 MCQs each" navBack={true} navTitle="CSE College Teacher">
  <div class="max-w-4xl mx-auto px-4 py-10">
    <div class="text-center mb-10">
      <div class="w-16 h-16 rounded-3xl bg-brand-50 flex items-center justify-center text-3xl mx-auto mb-5">📚</div>
      <h1 class="text-3xl font-bold text-surface-900 mb-2">CSE College Teacher</h1>
      <p class="text-surface-400">10 chapters × 30 MCQs each</p>
    </div>
    <div id="chapters" class="space-y-4">
      <div class="flex justify-center py-12">
        <div class="w-10 h-10 border-4 border-surface-200 border-t-brand-500 rounded-full animate-spin"></div>
      </div>
    </div>
  </div>
  <script is:inline>
    async function load() {
      const el = document.getElementById('chapters');
      try {
        const res = await fetch('/api/exams/cse-college-teacher');
        const exams = await res.json();
        if (exams.length === 0) {
          el.innerHTML = '<div class="text-center py-20"><div class="w-20 h-20 rounded-3xl bg-surface-100 flex items-center justify-center text-4xl mx-auto mb-6">📭</div><h3 class="text-xl font-semibold text-surface-700 mb-2">No CSE exams yet</h3><p class="text-surface-400">Check back later</p></div>';
          return;
        }
        el.innerHTML = exams.map((e, i) => `
          <div class="card p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 animate-fade-up" style="animation-delay:${i*0.05}s;opacity:0;">
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-bold text-surface-900 mb-1">${e.title}</h3>
              <div class="flex items-center gap-4 text-sm text-surface-400">
                <span>${e.totalQuestions} questions</span>
                <span>${e.durationMinutes||0} min</span>
              </div>
            </div>
            <div class="flex gap-3 shrink-0">
              <a href="/exam-intro/${e.id}" class="btn-primary text-sm px-6 py-2.5">Start</a>
              <button onclick="navigator.clipboard.writeText(window.location.origin+'/exam-intro/${e.id}');window.showToast('Link copied!')" class="btn-ghost text-sm px-4 py-2.5">Share</button>
            </div>
          </div>
        `).join('');
      } catch { el.innerHTML = '<p class="text-center text-red-500 py-12">Error loading chapters.</p>'; }
    }
    load();
  </script>
</Layout>
