---
import Layout from '../layouts/Layout.astro';
const examId = Astro.url.searchParams.get('id') || '';
---
<Layout title="Exam - Exam Portal">
  <div id="timer" class="fixed top-4 right-4 bg-white px-5 py-3 rounded-xl shadow-xl font-bold text-lg z-50 border-2 border-slate-200 hidden">00:00</div>
  <div class="bg-gradient-to-br from-primary-600 to-primary-900 text-white py-8 px-4 text-center">
    <h1 id="exam-title" class="text-2xl font-extrabold">Loading...</h1>
  </div>
  <div class="max-w-3xl mx-auto px-4 py-6">
    <div class="h-2 bg-slate-200 rounded-full mb-6 overflow-hidden"><div id="progress" class="h-full bg-gradient-to-r from-primary-500 to-primary-400 rounded-full transition-all duration-500" style="width:0%"></div></div>
    <div id="questions" class="space-y-5">
      <div class="flex justify-center py-12"><div class="w-10 h-10 border-4 border-slate-200 border-t-primary-500 rounded-full animate-spin"></div></div>
    </div>
    <button id="submit-btn" class="w-full py-4 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-xl font-bold text-lg mt-6 hidden hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 btn-glow">Submit Exam</button>
  </div>
  <script is:inline define:vars={{ examId }}>
    let questions = [], answers = {}, timerInterval, secondsElapsed = 0;

    async function loadExam() {
      try {
        const res = await fetch(`/api/exam/${examId}`);
        const exam = await res.json();
        document.getElementById('exam-title').textContent = exam.title;
        const qRes = await fetch(`/api/exam/${examId}/questions`);
        questions = await qRes.json();
        renderQuestions();
        document.getElementById('submit-btn').classList.remove('hidden');
        if (exam.durationMinutes > 0) startTimer(exam.durationMinutes * 60);
      } catch { document.getElementById('questions').innerHTML = '<p class="text-center text-red-500 py-12">Error loading exam.</p>'; }
    }

    function renderQuestions() {
      const labels = ['A','B','C','D'];
      document.getElementById('questions').innerHTML = questions.map((q, i) => `
        <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm animate-fade-in-up" style="animation-delay:${i*0.04}s;opacity:0;">
          <div class="inline-flex items-center justify-center w-8 h-8 bg-primary-500 text-white rounded-full text-sm font-bold mb-3">${i+1}</div>
          <p class="text-lg font-medium mb-4 leading-relaxed">${q.questionText}</p>
          <div class="space-y-2.5">
            ${q.options.map((opt, oi) => `
              <div class="flex items-center gap-3 p-3.5 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-primary-300 hover:bg-primary-50/50 transition-all duration-200" onclick="selectOption(${i},${oi})" id="opt-${i}-${oi}">
                <span class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold shrink-0">${labels[oi]}</span>
                <span class="font-medium">${opt}</span>
              </div>
            `).join('')}
          </div>
        </div>
      `).join('');
    }

    function selectOption(qi, oi) {
      questions[qi].options.forEach((_, j) => document.getElementById(`opt-${qi}-${j}`).classList.remove('selected','border-primary-500','bg-primary-50'));
      document.getElementById(`opt-${qi}-${oi}`).classList.add('selected','border-primary-500','bg-primary-50');
      answers[qi] = oi;
      document.getElementById('progress').style.width = (Object.keys(answers).length / questions.length * 100) + '%';
    }

    function startTimer(total) {
      const el = document.getElementById('timer');
      el.classList.remove('hidden');
      timerInterval = setInterval(() => {
        secondsElapsed++;
        const rem = total - secondsElapsed;
        if (rem <= 0) { clearInterval(timerInterval); submitExam(); return; }
        const m = Math.floor(rem/60), s = rem%60;
        el.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
        el.className = el.className.replace(/border-\w+-\d+/g, '') + (rem <= 60 ? ' border-red-500 text-red-600 animate-pulse' : rem <= 300 ? ' border-amber-500 text-amber-600' : ' border-slate-200');
      }, 1000);
    }

    document.getElementById('submit-btn').addEventListener('click', () => { if (confirm('Submit exam?')) submitExam(); });

    async function submitExam() {
      clearInterval(timerInterval);
      let score = 0;
      questions.forEach((q, i) => { if (answers[i] === q.correctOptionIndex) score++; });
      const studentName = sessionStorage.getItem('studentName') || 'Anonymous';
      try {
        const res = await fetch('/api/attempt', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ examId, studentName, score, total: questions.length, answers, timeTaken: secondsElapsed }) });
        const data = await res.json();
        window.location.href = `/result?id=${data.id}&examId=${examId}&score=${score}`;
      } catch { window.showToast('Error submitting'); }
    }

    loadExam();
  </script>
</Layout>
